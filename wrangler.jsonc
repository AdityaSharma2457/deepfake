{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frame-model-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MODEL_API_URL": ""
  }
}
